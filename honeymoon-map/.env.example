# Google Maps Platform API 키
# Google Cloud Console에서 Maps JavaScript API / Routes API / Places API 를 활성화한 뒤
# 발급받은 키를 아래에 넣고 이 파일을 `.env` 로 복사하세요.
#
#   cp .env.example .env
#
# 키가 없어도 일정표·예약 멘트·체크리스트·네비 버튼은 정상 동작합니다.
# (지도와 거리/시간 자동계산만 비활성화됩니다.)
VITE_GOOGLE_MAPS_API_KEY=

# (선택) 지도 Advanced Marker 사용 시 필요한 Map ID. 없으면 비워두세요.
VITE_GOOGLE_MAPS_MAP_ID=

# 공용 동기화: Vercel에서 Private Blob 저장소를 연결하면 자동 생성됩니다.
# 서버 전용입니다. VITE_ 접두사를 붙이거나 Git에 실제 값을 올리지 마세요.
BLOB_READ_WRITE_TOKEN=
# 생략하면 기존 내장 첨부 암호로 공유에 연결합니다.
HONEYMOON_SYNC_PASSWORD=
